# v4 内核版本轨道 —— 唯一手工维护的版本决策文件。
# 轨道语法：
#   pin:v<x.y.z>    钉死某个 tag（Xray 的 tag 全标 prerelease，/releases/latest 不可用，见 v3 server/update.sh:1804-1813）
#   minor:<x.y>     取该 minor 下最高 patch（sing-box 上限 1.14：1.15 起 1.14 的弃用项变致命）
#   major:<x>       取该 major 下最新版本
#   appmajor:<x>    同 major，但上游 tag 形如 app/v<x.y.z>（hysteria）
# 改这里之后必须跑：bash scripts/release/pin-kernels.sh --write && git add scripts/release/kernels.lock
SINGBOX_REPO="SagerNet/sing-box"
SINGBOX_TRACK="minor:1.14"
# 随发布分发的 sing-box 自建（唯一动机：官方归档不带 with_v2ray_api，住宅计量要它）。
# 取值 = 官方同版本 linux 归档 `sing-box version` 打印的 Tags（2026-09-16 用 v1.14.1
# 的 sing-box-1.14.1-linux-amd64.tar.gz 实测，= release/DEFAULT_BUILD_TAGS + with_purego）
# 逐 token 照抄，再加 with_v2ray_api；构建产物的 Tags 必须 ⊇ 官方那一串，不满足即判红。
# 不许凭记忆改：换 minor 轨道时重新用官方归档实测一次再写。
SINGBOX_TAGS="with_gvisor,with_quic,with_dhcp,with_wireguard,with_utls,with_acme,with_clash_api,with_tailscale,with_ccm,with_ocm,with_cloudflared,with_naive_outbound,with_usbip,with_openvpn,with_openconnect,badlinkname,tfogo_checklinkname0,with_purego,with_v2ray_api"
SINGBOX_CHECK_MINORS="1.12 1.13"   # CI 里额外做 `sing-box check` 的旧 minor（1.14 已是 target，且不自建）
XRAY_REPO="XTLS/Xray-core"
XRAY_TRACK="pin:v26.3.27"
HYSTERIA_REPO="apernet/hysteria"
HYSTERIA_TRACK="appmajor:2"
CADDY_REPO="caddyserver/caddy"
CADDY_TRACK="major:2"
